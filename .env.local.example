# Anthropic — server-side only, never exposed to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Turso (libSQL). For local dev a file DB works; prod uses a real Turso URL.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=dev

# Auth — generate with: node -e "console.log(require(\047crypto\047).randomBytes(32).toString(\047hex\047))"
AUTH_SECRET=
